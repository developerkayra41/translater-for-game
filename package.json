      "src/index.html",
      "src/capture.html"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "@vitalets/google-translate-api": "^9.2.1",
    "deepl-node": "^1.28.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
