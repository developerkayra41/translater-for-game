{
  "name": "game-ocr-translator",
  "version": "1.0.0",
  "description": "Anlık Çeviri Uygulaması",
  "main": "dist/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "start": "tsc && electron .",
    "pack": "tsc && electron-builder --win portable"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.ocr.translator",
    "productName": "Oyun Ceviri - Kayra",
    "directories": {
